{
  "name": "avaliador",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run a11y",
    "validate": "npm run lint && npm run test:coverage && npm run test:a11y",
    "mocks:reset": "node scripts/dev-with-mocks.mjs --reset-only",
    "mocks": "node scripts/dev-with-mocks.mjs --mocks-only",
    "dev:full": "node scripts/dev-with-mocks.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^31.0.1",
    "json-server": "0.17.4",
    "msw": "^3.0.7",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
